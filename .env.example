# Isobar — environment variables
#
# The bundled demo mode (DemoDatasetProvider) needs NONE of these — it is
# fully offline and deterministic. These are only relevant if you wire up
# live data providers yourself; see README.md § "Using real API keys
# (optional, advanced)" for exactly what that does and does not get you
# out of the box today.

# Google Contrails API — https://developers.google.com/contrails
# Google Cloud API key with the Contrails API enabled on the project.
# Read (as a constructor param, not auto-loaded) by
# src/data/providers/googleContrailsProvider.ts.
GOOGLE_CONTRAILS_API_KEY=

# OpenSky Network — https://opensky-network.org
# OAuth2 client-credentials pair, created from your OpenSky account page.
# Required since March 2026 (basic auth was retired). Not yet read by any
# file in this repo — there is no OpenSky client implementation here yet,
# only the "opensky-historical" provenance tag in src/models/flight.ts.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
